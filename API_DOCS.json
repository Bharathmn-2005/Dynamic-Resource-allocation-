{\n  "info": {\n    "title": "Train Ticket Booking System APIs\",\n    "description": \"Complete API documentation for all microservices\",\n    "version": "1.0.0\",\n    \"contact": {\n      \"name\": \"Support\",\n      \"email\": \"support@trainticket.com\"\n    }\n  },\n  \"servers\": [\n    {\n      \"url\": \"http://localhost\",\n      \"description\": \"Local Development\"\n    },\n    {\n      \"url\": \"https://api.trainticket.com\",\n      \"description\": \"Production\"\n    }\n  ],\n  \"paths\": {\n    \"/auth/register\": {\n      \"post\": {\n        \"summary\": \"Register new user\",\n        \"tags\": [\"Authentication\"],\n        \"requestBody\": {\n          \"required\": true,\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"type\": \"object\",\n                \"properties\": {\n                  \"username\": {\"type\": \"string\", \"minLength\": 3},\n                  \"email\": {\"type\": \"string\", \"format\": \"email\"},\n                  \"password\": {\"type\": \"string\", \"minLength\": 8},\n                  \"full_name\": {\"type\": \"string\"},\n                  \"phone\": {\"type\": \"string\"},\n                  \"date_of_birth\": {\"type\": \"string\", \"format\": \"date\"}\n                },\n                \"required\": [\"username\", \"email\", \"password\", \"full_name\"]\n              }\n            }\n          }\n        },\n        \"responses\": {\n          \"201\": {\"description\": \"User registered successfully\"},\n          \"400\": {\"description\": \"Invalid input\"},\n          \"409\": {\"description\": \"User already exists\"}\n        }\n      }\n    },\n    \"/auth/login\": {\n      \"post\": {\n        \"summary\": \"User login\",\n        \"tags\": [\"Authentication\"],\n        \"requestBody\": {\n          \"required\": true,\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"type\": \"object\",\n                \"properties\": {\n                  \"email\": {\"type\": \"string\", \"format\": \"email\"},\n                  \"password\": {\"type\": \"string\"}\n                },\n                \"required\": [\"email\", \"password\"]\n              }\n            }\n          }\n        },\n        \"responses\": {\n          \"200\": {\"description\": \"Login successful\"},\n          \"401\": {\"description\": \"Invalid credentials\"}\n        }\n      }\n    },\n    \"/api/trains/search\": {\n      \"get\": {\n        \"summary\": \"Search trains\",\n        \"tags\": [\"Trains\"],\n        \"parameters\": [\n          {\"name\": \"from\", \"in\": \"query\", \"required\": true, \"description\": \"Source station\"},\n          {\"name\": \"to\", \"in\": \"query\", \"required\": true, \"description\": \"Destination station\"},\n          {\"name\": \"date\", \"in\": \"query\", \"required\": true, \"description\": \"Journey date (YYYY-MM-DD)\"},\n          {\"name\": \"class\", \"in\": \"query\", \"description\": \"Train class\"}\n        ],\n        \"responses\": {\n          \"200\": {\"description\": \"List of available trains\"},\n          \"400\": {\"description\": \"Invalid parameters\"}\n        }\n      }\n    },\n    \"/api/booking/create\": {\n      \"post\": {\n        \"summary\": \"Create new booking\",\n        \"tags\": [\"Booking\"],\n        \"security\": [{\"Bearer\": []}],\n        \"requestBody\": {\n          \"required\": true,\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"type\": \"object\",\n                \"properties\": {\n                  \"train_id\": {\"type\": \"string\"},\n                  \"journey_date\": {\"type\": \"string\", \"format\": \"date\"},\n                  \"passenger_count\": {\"type\": \"integer\", \"minimum\": 1},\n                  \"passengers\": {\n                    \"type\": \"array\",\n                    \"items\": {\n                      \"type\": \"object\",\n                      \"properties\": {\n                        \"name\": {\"type\": \"string\"},\n                        \"age\": {\"type\": \"integer\"},\n                        \"gender\": {\"type\": \"string\", \"enum\": [\"M\", \"F\"]}\n                      }\n                    }\n                  }\n                },\n                \"required\": [\"train_id\", \"journey_date\", \"passenger_count\", \"passengers\"]\n              }\n            }\n          }\n        },\n        \"responses\": {\n          \"201\": {\"description\": \"Booking created successfully\"},\n          \"400\": {\"description\": \"Invalid input\"},\n          \"402\": {\"description\": \"Seats not available\"}\n        }\n      }\n    },\n    \"/api/payments/initiate\": {\n      \"post\": {\n        \"summary\": \"Initiate payment\",\n        \"tags\": [\"Payment\"],\n        \"security\": [{\"Bearer\": []}],\n        \"requestBody\": {\n          \"required\": true,\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"type\": \"object\",\n                \"properties\": {\n                  \"booking_id\": {\"type\": \"string\"},\n                  \"amount\": {\"type\": \"number\", \"format\": \"decimal\"},\n                  \"payment_method\": {\"type\": \"string\", \"enum\": [\"CARD\", \"UPI\", \"NETBANKING\"]}\n                },\n                \"required\": [\"booking_id\", \"amount\"]\n              }\n            }\n          }\n        },\n        \"responses\": {\n          \"201\": {\"description\": \"Payment initiated\"},\n          \"400\": {\"description\": \"Invalid booking or amount\"}\n        }\n      }\n    }\n  },\n  \"components\": {\n    \"securitySchemes\": {\n      \"Bearer\": {\n        \"type\": \"http\",\n        \"scheme\": \"bearer\",\n        \"bearerFormat\": \"JWT\"\n      }\n    }\n  }\n}\n