# Train Ticket Reservation System - Environment Variables
# Copy this file to .env and fill in with your actual values
# DO NOT commit .env to version control

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# Authentication Service Database
AUTH_DB_URL=jdbc:postgresql://postgres:5432/auth_service
AUTH_DB_USERNAME=postgres
AUTH_DB_PASSWORD=postgres_password

# Booking Service Database
BOOKING_DB_URL=jdbc:postgresql://postgres:5432/booking_service
BOOKING_DB_USERNAME=postgres
BOOKING_DB_PASSWORD=postgres_password

# Payment Service Database
PAYMENT_DB_URL=jdbc:postgresql://postgres:5432/payment_service
PAYMENT_DB_USERNAME=postgres
PAYMENT_DB_PASSWORD=postgres_password

# Notification Service Database
NOTIFICATION_DB_URL=jdbc:postgresql://postgres:5432/notification_service
NOTIFICATION_DB_USERNAME=postgres
NOTIFICATION_DB_PASSWORD=postgres_password

# ============================================================================
# EMAIL CONFIGURATION (SMTP)
# ============================================================================

# Gmail SMTP Settings
# Note: For Gmail, use an App Password instead of your regular password
# Generate at: https://myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# ============================================================================
# SERVICE URLs
# ============================================================================

# Frontend Application URL
APP_FRONTEND_BASE_URL=http://localhost:5173

# Service Discovery (Eureka)
EUREKA_SERVER_URL=http://localhost:8761/eureka

# Spring Cloud Config Server
CONFIG_SERVER_URL=http://localhost:8888

# Booking Service URL (used by Payment Service)
BOOKING_SERVICE_URL=http://booking-service:8082

# Notification Service URL (used by Booking Service)
NOTIFICATION_SERVICE_URL=http://notification-service:8081

# ============================================================================
# PAYMENT GATEWAY CONFIGURATION
# ============================================================================

# Payment Provider: SANDBOX (default for development) or RAZORPAY
PAYMENT_PROVIDER=SANDBOX
PAYMENT_CURRENCY=INR

# Razorpay Credentials (only needed if PAYMENT_PROVIDER=RAZORPAY)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================

REDIS_HOST=redis
REDIS_PORT=6379

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

# Timezone
APP_TIMEZONE=Asia/Kolkata

# Ticket Reminder Configuration
TICKET_REMINDER_ENABLED=true
TICKET_REMINDER_DAYS_BEFORE=1

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================

# JWT Secret Key (should be at least 32 characters)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# JWT Expiration (in milliseconds, default: 24 hours)
JWT_EXPIRATION=86400000

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log Level: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO

# ============================================================================
# DOCKER COMPOSE CONFIGURATION
# ============================================================================

# PostgreSQL Container Configuration
POSTGRES_INITDB_ARGS=-c shared_preload_libraries=pg_stat_statements
POSTGRES_MAX_CONNECTIONS=200
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis Container Configuration
REDIS_MAX_MEMORY=256mb

# Frontend build/runtime
VITE_AUTH_SERVICE_URL=http://localhost:8080
VITE_BOOKING_SERVICE_URL=http://localhost:8082
VITE_PAYMENT_SERVICE_URL=http://localhost:8083

# Optional dataset import path used by booking service
APP_DATASET_PATH=file:/C:/Users/BHARATH M N/Downloads/Railway Ticket Confirmation-4.csv
